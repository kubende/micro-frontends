# Cloudflare Pages headers for the shell. The hashed chunks under /static/
# are immutable; index.html should always be revalidated so a fresh deploy
# is picked up quickly.

/index.html
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/static/*
  Cache-Control: public, max-age=31536000, immutable
