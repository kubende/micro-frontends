# Cloudflare Pages headers — copied into dist/ by rsbuild output.copy.
# Tighten Access-Control-Allow-Origin to the production shell origin before
# going to production (e.g. https://app.example.com).

/mf-manifest.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/remoteEntry.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/static/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
